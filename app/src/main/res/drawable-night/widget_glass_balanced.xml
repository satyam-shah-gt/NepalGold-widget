<?xml version="1.0" encoding="utf-8"?>
<!-- Night variant of the frosted glass surface: darker, still translucent. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="@dimen/widget_corner_radius" />

    <gradient
        android:angle="270"
        android:centerColor="#9922262F"
        android:endColor="#80202630"
        android:startColor="#B3222630"
        android:type="linear" />

    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
