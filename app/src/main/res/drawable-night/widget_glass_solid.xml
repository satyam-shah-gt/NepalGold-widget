<?xml version="1.0" encoding="utf-8"?>
<!-- Night variant of the most solid level: darker and nearly opaque. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="@dimen/widget_corner_radius" />

    <gradient
        android:angle="270"
        android:centerColor="#B3222630"
        android:endColor="#99202630"
        android:startColor="#CC222630"
        android:type="linear" />

    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
</shape>
