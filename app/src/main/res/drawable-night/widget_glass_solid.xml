<?xml version="1.0" encoding="utf-8"?>
<!--
    Night variant of the solid level: completely opaque, so nothing of the wallpaper shows
    through. The shape and the hairline are the same as at every other level.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="@dimen/widget_corner_radius" />

    <gradient
        android:angle="270"
        android:centerColor="#FF252932"
        android:endColor="#FF20242E"
        android:startColor="#FF2A2E38"
        android:type="linear" />

    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
</shape>
