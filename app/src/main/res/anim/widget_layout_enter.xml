<?xml version="1.0" encoding="utf-8"?>
<!--
    Staggered reveal for the rate rows. Each child of the rate container fades and slides up in
    turn, which produces the "open" reveal and repeats every time the widget reloads.
-->
<layoutAnimation xmlns:android="http://schemas.android.com/apk/res/android"
    android:animation="@anim/widget_item_enter"
    android:animationOrder="normal"
    android:delay="12%" />
