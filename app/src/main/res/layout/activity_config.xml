<?xml version="1.0" encoding="utf-8"?>
<!--
    The settings screen - the app UI that opens when the widget is tapped.

    It is built in the One UI 9 proportions: the latest rate is the focus block at the top, the
    settings sit in cards around it, the history is a table and the one action the screen has
    is pinned to the bottom, where the thumb is.

    Every label that can change with the language is set in code, because the screen picks its
    own language and the ones baked into the layout would follow the device instead.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/config_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame"><!--
        The root cannot be a <merge>: it is the content view of the Activity, so it is
        inflated without a parent. The page colour is the theme's window background, which
        keeps the screen from painting over it.
    -->

    <ScrollView
        android:id="@+id/config_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/config_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_margin_screen"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/ui_margin_screen"
            android:paddingBottom="24dp">

            <!-- The title of the screen. -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/config_title"
                android:textColor="@color/ui_on_surface"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/config_subtitle"
                android:textColor="@color/ui_on_surface_variant"
                android:textSize="12.5sp" />

            <!-- The focus block: the latest rate. -->
            <LinearLayout
                android:id="@+id/headerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/ui_card_background"
                android:orientation="vertical"
                android:padding="@dimen/ui_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/headerMetalChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ui_chip_background"
                        android:letterSpacing="0.08"
                        android:maxLines="1"
                        android:paddingStart="11dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="5dp"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/headerDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="@color/ui_on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/headerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.16"
                    android:maxLines="1"
                    android:text="@string/widget_rate_label"
                    android:textColor="@color/ui_on_surface_variant"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/headerAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="@color/ui_on_surface"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/headerUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="3dp"
                        android:maxLines="1"
                        android:textColor="@color/ui_on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/headerChange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ui_chip_background"
                    android:maxLines="1"
                    android:paddingStart="11dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="5dp"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/headerSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:maxLines="1"
                    android:text="@string/config_source"
                    android:textColor="@color/ui_on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Notifications. -->
            <LinearLayout
                android:id="@+id/notificationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/ui_surface_card"
                android:orientation="vertical"
                android:padding="@dimen/ui_card_padding">

                <TextView
                    android:id="@+id/notificationTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_notifications_title"
                    android:textColor="@color/ui_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/notificationStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ui_on_surface_variant"
                    android:textSize="12.5sp" />

                <Button
                    android:id="@+id/notificationButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/ui_secondary_button"
                    android:includeFontPadding="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:stateListAnimator="@null"
                    android:text="@string/config_notifications_enable"
                    android:textAllCaps="false"
                    android:textColor="@color/ui_on_surface"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Language. -->
            <LinearLayout
                android:id="@+id/languageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/ui_surface_card"
                android:orientation="vertical"
                android:padding="@dimen/ui_card_padding">

                <TextView
                    android:id="@+id/languageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_language_title"
                    android:textColor="@color/ui_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/languageHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/config_language_hint"
                    android:textColor="@color/ui_on_surface_variant"
                    android:textSize="12sp" />

                <com.goldrate.widget.ui.SegmentedControl
                    android:id="@+id/languageControl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- The metal the widget shows. -->
            <LinearLayout
                android:id="@+id/metalCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/ui_surface_card"
                android:orientation="vertical"
                android:padding="@dimen/ui_card_padding">

                <TextView
                    android:id="@+id/metalTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_metal_title"
                    android:textColor="@color/ui_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/metalHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/config_metal_hint"
                    android:textColor="@color/ui_on_surface_variant"
                    android:textSize="12sp" />

                <com.goldrate.widget.ui.SegmentedControl
                    android:id="@+id/metalControl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- How much of the wallpaper shows through the widget. -->
            <LinearLayout
                android:id="@+id/transparencyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/ui_surface_card"
                android:orientation="vertical"
                android:padding="@dimen/ui_card_padding">

                <TextView
                    android:id="@+id/transparencyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_transparency_title"
                    android:textColor="@color/ui_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/transparencyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/config_transparency_hint"
                    android:textColor="@color/ui_on_surface_variant"
                    android:textSize="12sp" />

                <com.goldrate.widget.ui.SegmentedControl
                    android:id="@+id/transparencyControl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- The stored history, as a table. -->
            <LinearLayout
                android:id="@+id/historyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/ui_surface_card"
                android:orientation="vertical"
                android:padding="@dimen/ui_card_padding">

                <TextView
                    android:id="@+id/historyTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ui_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/historyCaptionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/ui_on_surface_variant"
                    android:textSize="11.5sp" />

                <LinearLayout
                    android:id="@+id/historyContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- The one action of the screen, in the interaction area at the bottom. -->
    <LinearLayout
        android:id="@+id/config_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/ui_page_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_margin_screen"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/ui_margin_screen"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/ui_primary_button"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:stateListAnimator="@null"
            android:text="@string/config_refresh_now"
            android:textAllCaps="false"
            android:textColor="@color/ui_on_accent"
            android:textSize="14.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
