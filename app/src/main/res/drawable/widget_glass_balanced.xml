<?xml version="1.0" encoding="utf-8"?>
<!--
    The frosted glass surface of the widget, at the transparency the widget ships with.

    It is deliberately translucent so the wallpaper shows through, like a Samsung One UI widget.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="@dimen/widget_corner_radius" />

    <gradient
        android:angle="270"
        android:centerColor="#D2FFFFFF"
        android:endColor="#B4FFFFFF"
        android:startColor="#E6FFFFFF"
        android:type="linear" />

    <stroke
        android:width="1dp"
        android:color="#4DFFFFFF" />
</shape>
