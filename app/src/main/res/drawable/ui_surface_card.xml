<?xml version="1.0" encoding="utf-8"?>
<!--
    The plain card of the settings screen: a solid surface with a hairline border, in the
    proportions of a One UI 9 focus block.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="@dimen/ui_radius_large" />

    <solid android:color="@color/ui_surface" />

    <stroke
        android:width="1dp"
        android:color="@color/ui_outline" />
</shape>
