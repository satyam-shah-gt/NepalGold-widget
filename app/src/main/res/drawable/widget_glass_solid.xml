<?xml version="1.0" encoding="utf-8"?>
<!--
    The solid level of the widget's surface: completely opaque, so nothing of the wallpaper
    shows through. The shape and the hairline are the same as at every other level.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="@dimen/widget_corner_radius" />

    <gradient
        android:angle="270"
        android:centerColor="#FFFAFAFA"
        android:endColor="#FFF4F4F4"
        android:startColor="#FFFFFFFF"
        android:type="linear" />

    <stroke
        android:width="1dp"
        android:color="#66FFFFFF" />
</shape>
