<?xml version="1.0" encoding="utf-8"?>
<!--
    The most solid level of the frosted glass surface: the least wallpaper shows through here.
    The shape and the hairline are the same as at every other level.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="@dimen/widget_corner_radius" />

    <gradient
        android:angle="270"
        android:centerColor="#F2FFFFFF"
        android:endColor="#E6FFFFFF"
        android:startColor="#F7FFFFFF"
        android:type="linear" />

    <stroke
        android:width="1dp"
        android:color="#66FFFFFF" />
</shape>
