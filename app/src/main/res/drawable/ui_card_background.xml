<?xml version="1.0" encoding="utf-8"?>
<!--
    The glass focus block of the settings screen.

    The same translucent surface as the widget, so the settings screen and the widget read as
    one app. The colours are colour resources, so the night variant follows the system theme
    without a second drawable.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="@dimen/ui_radius_large" />

    <gradient
        android:angle="270"
        android:endColor="@color/ui_card_end"
        android:startColor="@color/ui_card_start"
        android:type="linear" />

    <stroke
        android:width="1dp"
        android:color="@color/ui_card_stroke" />
</shape>
