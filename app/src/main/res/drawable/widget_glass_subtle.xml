<?xml version="1.0" encoding="utf-8"?>
<!--
    The most transparent level of the frosted glass surface: the wallpaper shows through the
    most here. The shape and the hairline are the same as at every other level.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="@dimen/widget_corner_radius" />

    <gradient
        android:angle="270"
        android:centerColor="#8AFFFFFF"
        android:endColor="#70FFFFFF"
        android:startColor="#99FFFFFF"
        android:type="linear" />

    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
