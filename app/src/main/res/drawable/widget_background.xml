<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget surface. A soft vertical gradient with large rounded corners, in the spirit of
    One UI. Colours come from colour resources so the night variant reuses this same drawable.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_corner_radius" />

    <gradient
        android:angle="270"
        android:endColor="@color/widget_bg_end"
        android:startColor="@color/widget_bg_start"
        android:type="linear" />
</shape>
