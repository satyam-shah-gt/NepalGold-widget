<?xml version="1.0" encoding="utf-8"?>
<!--
    Themed (monochrome) icon layer for Android 13+. It is a simplified silhouette of the logo:
    a gold ingot with a rising trend line. The system tints it, so it must be a single colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#FFFFFFFF">

    <!-- The ingot. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M36,56 L72,56 L82,74 L26,74 Z" />

    <!-- The rising trend line. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M30,46 L44,34 L55,42 L74,24"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="5" />

    <!-- Arrow head. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M79,18 L79,31 L66,18 Z" />
</vector>
