<?xml version="1.0" encoding="utf-8"?>
<!-- The secondary action: a quiet pill with a hairline border and a ripple on press. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ui_ripple">

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_card_start" />
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="@color/ui_outline" />
        </shape>
    </item>
</ripple>
